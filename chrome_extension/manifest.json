{
  "manifest_version": 3,
  "name": "Idle Game Agent - Monitor de Abas",
  "version": "0.2.7",
  "description": "Monitora abas e métricas numéricas do Poke Idle IO, com recomendações em simulação.",
  "permissions": [
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://pokeidle.io/*",
    "https://www.pokeidle.io/*",
    "https://poke.idleworld.online/*",
    "http://127.0.0.1:8768/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Idle Game Agent",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://pokeidle.io/*",
        "https://www.pokeidle.io/*"
      ],
      "js": [
        "content_io.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
